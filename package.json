{
  "name": "oauth-login-demo",
  "version": "1.0.0",
  "description": "OAuth login gateway supporting Google and Apple authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup-gateway.js",
    "build": "echo 'No build step required for Node.js app' && npm install",
    "deploy": "bash deploy.sh",
    "pm2:start": "pm2 start server.js --name oauth-gateway",
    "pm2:stop": "pm2 stop oauth-gateway",
    "pm2:restart": "pm2 restart oauth-gateway",
    "pm2:logs": "pm2 logs oauth-gateway"
  },
  "keywords": ["oauth", "google", "apple", "login", "authentication"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-apple": "^2.0.2",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "mysql2": "^3.6.5",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
